POSTGRES_USER=reliqa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=reliqa_db

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://reliqa.io
AUTH_ALLOWED_EMAILS=
