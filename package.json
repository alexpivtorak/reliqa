{
  "name": "reliqa",
  "version": "1.0.0",
  "description": "Agentic QA Tester using Playwright and Google Gemini",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "tsx src/server/index.ts",
    "start:worker": "tsx src/worker/index.ts",
    "test": "playwright test",
    "test:manual": "tsx src/scripts/test-agent.ts",
    "test:chaos": "tsx src/scripts/test-agent.ts",
    "trigger": "tsx src/scripts/trigger-job.ts",
    "trigger:chaos": "tsx src/scripts/trigger-job.ts",
    "trigger:flow": "tsx src/scripts/trigger-flow.ts",
    "logs": "tsx src/scripts/view-logs.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push:pg",
    "lint": "eslint .",
    "infra:up": "docker-compose up -d postgres redis",
    "infra:down": "docker-compose down",
    "dev:all": "concurrently -n \"API,WRK,FE\" -c \"bgBlue,bgGreen,bgMagenta\" \"pnpm run start:server\" \"pnpm run start:worker\" \"pnpm --prefix web run dev\"",
    "up": "pnpm run infra:up && pnpm run dev:all",
    "clean:artifacts": "rm -rf artifacts/*",
    "clean:cache": "rm -f cache/action_cache.json",
    "clean": "pnpm run clean:artifacts && pnpm run clean:cache",
    "kill:all": "cmd /c \"taskkill /F /IM node.exe /T || exit 0\""
  },
  "keywords": [
    "ai",
    "qa",
    "playwright",
    "gemini",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.12.0",
    "@hono/node-server": "^1.19.17",
    "bullmq": "^5.81.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.30.10",
    "hono": "^4.12.33",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.3",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.20.18",
    "tsx": "^4.23.4",
    "typescript": "^5.9.3"
  }
}