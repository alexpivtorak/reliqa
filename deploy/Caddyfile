{
	# Origin certs for Cloudflare Full (not Full Strict).
	# Set Cloudflare SSL/TLS mode to "Full".
	auto_https disable_redirects
}

# Plain HTTP for Cloudflare health / Flexible fallback
http://reliqa.io, http://www.reliqa.io, :80 {
	encode gzip
	reverse_proxy web:3000
}

reliqa.io, www.reliqa.io {
	tls internal
	encode gzip

	# Next.js (proxies /api and /videos to the API container)
	reverse_proxy web:3000
}
