FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml .npmrc ./
# Browsers come from the Playwright base image
RUN pnpm install --frozen-lockfile --ignore-scripts --config.minimum-release-age=0

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=production
# Chromium needs shared memory in Docker
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Call tsx directly so pnpm does not re-check the lockfile at startup
CMD ["./node_modules/.bin/tsx", "src/worker/index.ts"]
